{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "XDownload",
  "version": "2.5.2",
  "identifier": "com.muzicul.xdownload",
  "build": {
    "beforeDevCommand": "pnpm --prefix ui dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --prefix ui build:web",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "XDownload v2.5.2",
        "width": 960,
        "height": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "media-src": "'self' asset: blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
