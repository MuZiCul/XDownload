{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "XDownload",
  "identifier": "com.muzicul.xdownload",
  "build": {
    "beforeDevCommand": "pnpm --prefix ui dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --prefix ui build:web",
    "frontendDist": "../ui/dist"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["xdownload"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCNThFMDdGQzEyMTM1MTYKUldRV05TSEJmK0JZMnh2V3MrU3NzSzNVTTRvMUJlcU9SS1hTMU5ITTRVWFZpNU92Wm5yRzRaQlYK",
      "endpoints": [
        "https://github.com/MuZiCul/XDownload/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "XDownload",
        "width": 960,
        "height": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "media-src": "'self' asset: blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
