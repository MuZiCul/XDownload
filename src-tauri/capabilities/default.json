{
  "identifier": "default",
  "description": "Default permissions for XDownload",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "shell:default",
    "clipboard-manager:default",
    "notification:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "yt-dlp-execute",
          "cmd": "${appDir}/bin/yt-dlp.exe",
          "args": true
        }
      ]
    }
  ]
}
